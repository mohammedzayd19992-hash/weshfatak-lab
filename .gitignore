# Flutter and Dart generated files
app/.dart_tool/
app/.flutter-plugins
app/.flutter-plugins-dependencies
app/.pub-cache/
app/.pub/
app/build/
app/coverage/

# Android machine-specific files and build output
app/android/local.properties
app/android/.gradle/
app/android/app/debug/
app/android/app/profile/
app/android/app/release/

# Editors and operating systems
.vscode/
.idea/
*.iml
.DS_Store
Thumbs.db

# Built install packages
*.apk
*.aab

# Secrets and signing files
.env
.env.*
!.env.example
**/key.properties
**/*.jks
**/*.keystore

# The live project's address and key, given to builds with --dart-define-from-file
app/config/live.json

# Collected data, logs and the X sign-in (also in collector/.gitignore)
collector/x-profile/
collector/data/
collector/logs/
**/__pycache__/

# The live project's history: imports with their logs and prompts, the first version's SQL and
# the migrations that only the live project needed. They stay in the private copy.
database/news-import/
database/v1-archive/
database/migrate-from-v1.sql
database/migrate-to-ministry.sql

# Generated by Flutter on each computer
app/android/app/src/main/java/io/flutter/plugins/GeneratedPluginRegistrant.java


