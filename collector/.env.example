# Copy this file to .env and fill in the keys. .env is never added to GitHub.

# Your Supabase project: Supabase dashboard -> Project Settings -> API Keys.
# The URL and the publishable key are the same ones the app is built with (app/config/live.json).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR-KEY
# Secret keys -> the secret key. Lets the collectors save to the database: it can change any data
# in the project, so it stays in this file, which Git ignores.
SUPABASE_SECRET_KEY=
# Without the key, UPLOAD_VIA=codex sends saved files through the Codex app's Supabase connector
# instead: each row is checked by its md5, but it takes minutes per file, so keep it for one-off
# uploads (python press.py upload FILE). The 2.5-hour autopilot needs the key.
UPLOAD_VIA=

# Optional. notes.py asks Codex on the ChatGPT plan the Codex app is signed in with, so no key is
# needed. NOTES_ENGINE=claude asks the Claude API instead, with the key from platform.claude.com.
ANTHROPIC_API_KEY=
NOTES_ENGINE=
# Optional: another Codex model than the one chosen in the Codex app, or where codex.exe is.
CODEX_MODEL=
CODEX_PATH=

# Optional autopilot settings (autopilot.py): hours between rounds, the most posts Codex reads in
# one round, and steps to leave out (for example x,youtube).
AUTOPILOT_EVERY_HOURS=2.5
NOTES_LIMIT=30
AUTOPILOT_SKIP=

# Optional. Google Cloud console -> YouTube Data API v3 -> Credentials -> API key.
# Lets youtube.py read the public comments under each video; without it, videos come without comments.
YOUTUBE_API_KEY=
