<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ splash screen: the adaptive icon on the night background. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/uninews_night</item>
        <item name="android:windowSplashScreenBackground">@color/uninews_night</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/uninews_night</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/uninews_night</item>
    </style>
</resources>
